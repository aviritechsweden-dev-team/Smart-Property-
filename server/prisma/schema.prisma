  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// REMOTE DEVICE COMMANDS
//////////////////////////////////////////////////////

enum DeviceCommandStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
}

model DeviceCommand {
  id                String @id @default(cuid())

  deviceId          String
  device            IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  userId            String
  user              User @relation(fields: [userId], references: [id])

  command           String

  payload           Json?

  status            DeviceCommandStatus @default(PENDING)

  response          Json?

  executedAt        DateTime?

  createdAt         DateTime @default(now())

  @@index([deviceId])
}

//////////////////////////////////////////////////////
// MARKETPLACE
//////////////////////////////////////////////////////

enum ListingType {
  SALE
  RENT
  SHORTLET
  LEASE
  LAND
  COMMERCIAL
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_OFFER
  RESERVED
  CLOSED
  EXPIRED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

//////////////////////////////////////////////////////
// PROPERTY LISTINGS
//////////////////////////////////////////////////////

model PropertyListing {
  id              String @id @default(cuid())

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  listingType     ListingType

  status          ListingStatus @default(DRAFT)

  title           String

  description     String?

  askingPrice     Decimal @db.Decimal(18,2)

  securityDeposit Decimal? @db.Decimal(18,2)

  serviceCharge   Decimal? @db.Decimal(18,2)

  minimumStay     Int?

  availableFrom   DateTime?

  availableTo     DateTime?

  publishedAt     DateTime?

  expiresAt       DateTime?

  views           Int @default(0)

  bookings        Booking[]
  inquiries       PropertyInquiry[]
  offers          PropertyOffer[]
  favourites      FavouriteProperty[]
  reviews         PropertyReview[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

//////////////////////////////////////////////////////
// BOOKINGS
//////////////////////////////////////////////////////

model Booking {
  id               String @id @default(cuid())

  listingId        String
  listing          PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  userId           String
  user             User @relation(fields: [userId], references: [id])

  checkIn          DateTime
  checkOut         DateTime

  guests           Int @default(1)

  totalAmount      Decimal @db.Decimal(18,2)

  bookingFee       Decimal? @db.Decimal(18,2)

  status           BookingStatus @default(PENDING)

  paymentId        String?
  payment          Payment? @relation(fields: [paymentId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([listingId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// PROPERTY OFFERS
//////////////////////////////////////////////////////

model PropertyOffer {
  id              String @id @default(cuid())

  listingId       String
  listing         PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId         String
  buyer           User @relation(fields: [buyerId], references: [id])

  offeredAmount   Decimal @db.Decimal(18,2)

  message         String?

  status          OfferStatus @default(PENDING)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([listingId])
}

//////////////////////////////////////////////////////
// PROPERTY INQUIRIES
//////////////////////////////////////////////////////

model PropertyInquiry {
  id             String @id @default(cuid())

  listingId      String
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  userId         String
  user           User @relation(fields: [userId], references: [id])

  subject        String

  message        String

  responded      Boolean @default(false)

  createdAt      DateTime @default(now())
}

//////////////////////////////////////////////////////
// FAVOURITES
//////////////////////////////////////////////////////

model FavouriteProperty {
  id             String @id @default(cuid())

  listingId      String
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  userId         String
  user           User @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())

  @@unique([listingId, userId])
}

//////////////////////////////////////////////////////
// REVIEWS
//////////////////////////////////////////////////////

model PropertyReview {
  id             String @id @default(cuid())

  listingId      String
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reviewerId     String
  reviewer       User @relation(fields: [reviewerId], references: [id])

  rating         Int

  title          String?

  review         String?

  createdAt      DateTime @default(now())

  @@index([listingId])
}

//////////////////////////////////////////////////////
// TOKENIZATION & INVESTMENT
//////////////////////////////////////////////////////

enum TokenizationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  TOKENIZED
  PAUSED
  CLOSED
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  PARTIALLY_EXITED
  EXITED
  CANCELLED
}

enum SmartContractStatus {
  DRAFT
  DEPLOYING
  DEPLOYED
  FAILED
  PAUSED
}

//////////////////////////////////////////////////////
// BLOCKCHAIN NETWORKS
//////////////////////////////////////////////////////

model BlockchainNetwork {
  id              String @id @default(cuid())

  name            String
  chainId         String @unique

  symbol          String

  rpcUrl          String?

  explorerUrl     String?

  active          Boolean @default(true)

  tokenizations   PropertyTokenization[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PROPERTY TOKENIZATION
//////////////////////////////////////////////////////

model PropertyTokenization {
  id                    String @id @default(cuid())

  propertyId            String
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  blockchainNetworkId   String
  blockchainNetwork     BlockchainNetwork @relation(fields: [blockchainNetworkId], references: [id])

  status                TokenizationStatus

  tokenSymbol           String

  tokenName             String

  totalSupply           Decimal @db.Decimal(30,8)

  tokenPrice            Decimal @db.Decimal(18,2)

  contractAddress       String?

  assetValue            Decimal @db.Decimal(18,2)

  availableTokens       Decimal @db.Decimal(30,8)

  smartContract         SmartContract?

  investments           PropertyInvestment[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// SMART CONTRACTS
//////////////////////////////////////////////////////

model SmartContract {
  id                   String @id @default(cuid())

  tokenizationId       String @unique
  tokenization         PropertyTokenization @relation(fields: [tokenizationId], references: [id], onDelete: Cascade)

  contractAddress      String @unique

  abi                  Json?

  bytecodeHash         String?

  deploymentTxHash     String?

  status               SmartContractStatus

  deployedAt           DateTime?

  createdAt            DateTime @default(now())
}

//////////////////////////////////////////////////////
// INVESTMENTS
//////////////////////////////////////////////////////

model PropertyInvestment {
  id                   String @id @default(cuid())

  tokenizationId       String
  tokenization         PropertyTokenization @relation(fields: [tokenizationId], references: [id], onDelete: Cascade)

  investorId           String
  investor             User @relation(fields: [investorId], references: [id])

  paymentId            String?
  payment              Payment? @relation(fields: [paymentId], references: [id])

  tokensPurchased      Decimal @db.Decimal(30,8)

  purchasePrice        Decimal @db.Decimal(18,2)

  investmentValue      Decimal @db.Decimal(18,2)

  walletAddress        String?

  transactionHash      String?

  status               InvestmentStatus

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([investorId])
  @@index([tokenizationId])
}

//////////////////////////////////////////////////////
// TOKEN TRANSFERS
//////////////////////////////////////////////////////

model TokenTransfer {
  id                  String @id @default(cuid())

  tokenizationId      String
  tokenization        PropertyTokenization @relation(fields: [tokenizationId], references: [id])

  fromWallet          String

  toWallet            String

  quantity            Decimal @db.Decimal(30,8)

  transactionHash     String @unique

  blockNumber         String?

  transferredAt       DateTime

  createdAt           DateTime @default(now())
}

//////////////////////////////////////////////////////
// DIVIDENDS
//////////////////////////////////////////////////////

model DividendDistribution {
  id                  String @id @default(cuid())

  tokenizationId      String
  tokenization        PropertyTokenization @relation(fields: [tokenizationId], references: [id])

  totalAmount         Decimal @db.Decimal(18,2)

  currency            Currency

  distributionDate    DateTime

  notes               String?

  createdAt           DateTime @default(now())
}

//////////////////////////////////////////////////////
// INVESTOR DIVIDENDS
//////////////////////////////////////////////////////

model InvestorDividend {
  id                    String @id @default(cuid())

  dividendId            String
  dividend              DividendDistribution @relation(fields: [dividendId], references: [id], onDelete: Cascade)

  investorId            String
  investor              User @relation(fields: [investorId], references: [id])

  paymentId             String?
  payment               Payment? @relation(fields: [paymentId], references: [id])

  amount                Decimal @db.Decimal(18,2)

  paid                  Boolean @default(false)

  paidAt                DateTime?

  createdAt             DateTime @default(now())

  @@unique([dividendId, investorId])
}

//////////////////////////////////////////////////////
// ENTERPRISE PLATFORM
// Notifications • Messaging • Audit Logs • AI • System
//////////////////////////////////////////////////////

enum NotificationType {
  SYSTEM
  PAYMENT
  PROPERTY
  BOOKING
  RENT
  BILL
  WALLET
  INVESTMENT
  SECURITY
  IOT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ConversationType {
  DIRECT
  PROPERTY
  SUPPORT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  PAYMENT
  EXPORT
  IMPORT
  VIEW
}

enum AIProvider {
  OPENAI
  GEMINI
  CLAUDE
  LOCAL
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model Notification {
  id               String @id @default(cuid())

  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type             NotificationType
  channel          NotificationChannel

  title            String
  body             String

  status           NotificationStatus @default(PENDING)

  data             Json?

  readAt           DateTime?

  sentAt           DateTime?

  createdAt        DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////
// CONVERSATIONS
//////////////////////////////////////////////////////

model Conversation {
  id              String @id @default(cuid())

  type            ConversationType

  title           String?

  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])

  participants    ConversationParticipant[]

  messages        Message[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PARTICIPANTS
//////////////////////////////////////////////////////

model ConversationParticipant {
  id              String @id @default(cuid())

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId          String
  user            User @relation(fields: [userId], references: [id])

  joinedAt        DateTime @default(now())

  @@unique([conversationId, userId])
}

//////////////////////////////////////////////////////
// MESSAGES
//////////////////////////////////////////////////////

model Message {
  id               String @id @default(cuid())

  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId         String
  sender           User @relation(fields: [senderId], references: [id])

  type             MessageType

  message          String?

  attachmentUrl    String?

  isRead           Boolean @default(false)

  createdAt        DateTime @default(now())
}

//////////////////////////////////////////////////////
// AUDIT LOGS
//////////////////////////////////////////////////////

model AuditLog {
  id              String @id @default(cuid())

  userId          String?
  user            User? @relation(fields: [userId], references: [id])

  action          AuditAction

  entity          String

  entityId        String

  description     String?

  ipAddress       String?

  userAgent       String?

  metadata        Json?

  createdAt       DateTime @default(now())

  @@index([entity])
  @@index([entityId])
}

//////////////////////////////////////////////////////
// AI REQUESTS
//////////////////////////////////////////////////////

model AIRequest {
  id              String @id @default(cuid())

  userId          String
  user            User @relation(fields: [userId], references: [id])

  provider        AIProvider

  prompt          String

  response        String?

  tokens          Int?

  cost            Decimal? @db.Decimal(18,6)

  createdAt       DateTime @default(now())
}

//////////////////////////////////////////////////////
// SYSTEM SETTINGS
//////////////////////////////////////////////////////

model SystemSetting {
  id             String @id @default(cuid())

  key            String @unique

  value          Json

  description    String?

  updatedBy      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

//////////////////////////////////////////////////////
// API KEYS
//////////////////////////////////////////////////////

model Integration {
  id             String @id @default(cuid())

  name           String @unique

  provider       String

  apiKey         String?

  secretKey      String?

  webhookSecret  String?

  configuration  Json?

  enabled        Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}