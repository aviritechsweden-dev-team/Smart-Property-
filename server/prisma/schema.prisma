//////////////////////////////////////////////////////
// PROPERTY
//////////////////////////////////////////////////////
// Fix: every `@relation(...)` in this model was written on its own
// continuation line (e.g. `organization Organization\n  @relation(...)`),
// which is invalid — relation attributes must stay on the same line as
// the field. All are now single-line.
// Added: trustStatus (the TrustStatus enum existed but no field used it),
// and back-relations for bookings, offers, leases, utility bills,
// marketplace listings, inspections, IoT devices, maintenance requests,
// and vendor jobs — all of which reference Property from the other side.

model Property {
  id                String @id @default(cuid())

  //////////////////////////////////////
  // Basic Information
  //////////////////////////////////////

  propertyCode      String @unique
  title             String
  slug              String @unique
  description       String?

  listingType       PropertyListingType
  status            PropertyStatus

  //////////////////////////////////////
  // Pricing
  //////////////////////////////////////

  price             Decimal @db.Decimal(18,2)
  serviceCharge     Decimal? @db.Decimal(18,2)
  cautionFee        Decimal? @db.Decimal(18,2)
  agencyFee         Decimal? @db.Decimal(18,2)
  legalFee          Decimal? @db.Decimal(18,2)
  currency          Currency @default(NGN)

  //////////////////////////////////////
  // Property Details
  //////////////////////////////////////

  bedrooms          Int?
  bathrooms         Int?
  toilets           Int?
  kitchens          Int?
  parkingSpaces     Int?
  floors            Int?
  yearBuilt         Int?

  landSize          Decimal? @db.Decimal(18,2)
  buildingSize      Decimal? @db.Decimal(18,2)
  measurementUnit   String? @default("sqm")

  //////////////////////////////////////
  // Organization / Type / Owner / Agent / Location
  //////////////////////////////////////

  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])

  propertyTypeId    String
  propertyType      PropertyType @relation(fields: [propertyTypeId], references: [id])

  ownerId           String
  owner             User @relation("OwnedProperties", fields: [ownerId], references: [id])

  agentId           String?
  agent             User? @relation("ManagedProperties", fields: [agentId], references: [id])

  buildingId        String?
  building          Building? @relation(fields: [buildingId], references: [id])

  unitId            String?
  unit              Unit? @relation(fields: [unitId], references: [id])

  //////////////////////////////////////
  // Smart Trust
  //////////////////////////////////////

  trustScore        Decimal? @db.Decimal(5,2)
  trustStatus        TrustStatus?

  verified          Boolean @default(false)
  featured          Boolean @default(false)
  published         Boolean @default(false)

  //////////////////////////////////////
  // Counters
  //////////////////////////////////////

  totalViews        Int @default(0)
  totalFavorites    Int @default(0)
  totalBookings     Int @default(0)

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  address           PropertyAddress?
  amenities         PropertyAmenity[]
  features          PropertyFeature[]
  media             PropertyMedia[]
  documents         PropertyDocument[]
  coordinates       PropertyCoordinate[]
  parcel            LandParcel?
  surveyPlans       SurveyPlan[]
  geoJsonFiles      GeoJsonFile[]
  gisFiles          GISFile[]

  conversations     Conversation[]
  tokenization      PropertyTokenization?

  bookings          Booking[]
  offers            PropertyOffer[]
  inspections       PropertyInspection[]
  listings          PropertyListing[]
  leases            Lease[]

  utilityBills      UtilityBill[]
  iotDevices        IoTDevice[]
  maintenanceRequests MaintenanceRequest[]
  serviceHistory    ServiceHistory[]
  vendorJobs        VendorJob[]

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propertyCode])
  @@index([status])
  @@index([listingType])
  @@index([ownerId])
  @@index([agentId])
  @@index([organizationId])
  @@index([propertyTypeId])
}

