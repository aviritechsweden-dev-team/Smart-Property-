//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////
// Fix: every relation field here (payer, wallet, flutterwave, etc.) was
// split across two lines with `@relation` on a continuation line — not
// valid Prisma syntax. All fixed to single-line. Also added the
// back-relations Payment needs for Refund, Escrow, PaymentSplit,
// Commission, Invoice, RentInvoice, Booking, and UtilityBill, none of
// which existed in the original file.

model Payment {
  id                String @id @default(cuid())

  reference         String @unique

  payerId           String
  payer             User @relation(fields: [payerId], references: [id])

  walletId          String?
  wallet            Wallet? @relation(fields: [walletId], references: [id])

  purpose           PaymentPurpose
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)

  currency          Currency @default(NGN)

  amount            Decimal @db.Decimal(18,2)
  fee               Decimal? @db.Decimal(18,2)
  discount          Decimal? @db.Decimal(18,2)
  tax               Decimal? @db.Decimal(18,2)
  total             Decimal @db.Decimal(18,2)

  description       String?

  flutterwave       FlutterwaveTransaction?
  refunds           Refund[]
  escrow            Escrow?
  splits            PaymentSplit[]
  commissions       Commission[]
  invoices          Invoice[]
  rentInvoices      RentInvoice[]
  bookings          Booking[]
  utilityBills      UtilityBill[]
  vendorPayments    VendorPayment[]

  investments       PropertyInvestment[]
  investorDividends InvestorDividend[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([reference])
  @@index([payerId])
  @@index([status])
}

//////////////////////////////////////////////////////
// FLUTTERWAVE TRANSACTION
//////////////////////////////////////////////////////

model FlutterwaveTransaction {
  id                String @id @default(cuid())

