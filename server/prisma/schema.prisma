//////////////////////////////////////////////////////
// PROPERTY
//////////////////////////////////////////////////////

model Property {

  id                String   @id @default(cuid())

  //////////////////////////////////////
  // Basic Information
  //////////////////////////////////////

  propertyCode      String   @unique

  title             String

  slug              String   @unique

  description       String?

  listingType       PropertyListingType

  status            PropertyStatus

  conversations Conversation[]

  tokenization PropertyTokenization?

  //////////////////////////////////////
  // Pricing
  //////////////////////////////////////

  price             Decimal @db.Decimal(18,2)

  serviceCharge     Decimal? @db.Decimal(18,2)

  cautionFee        Decimal? @db.Decimal(18,2)

  agencyFee         Decimal? @db.Decimal(18,2)

  legalFee          Decimal? @db.Decimal(18,2)

  currency          Currency @default(NGN)

  //////////////////////////////////////
  // Property Details
  //////////////////////////////////////

  bedrooms          Int?

  bathrooms         Int?

  toilets           Int?

  kitchens          Int?

  parkingSpaces     Int?

  floors            Int?

  yearBuilt         Int?

  landSize          Decimal? @db.Decimal(18,2)

  buildingSize      Decimal? @db.Decimal(18,2)

  measurementUnit   String? @default("sqm")

  //////////////////////////////////////
  // Organization
  //////////////////////////////////////

  organizationId    String

  organization      Organization
      @relation(fields:[organizationId], references:[id])

  //////////////////////////////////////
  // Type
  //////////////////////////////////////

  propertyTypeId    String

  propertyType      PropertyType
      @relation(fields:[propertyTypeId], references:[id])

  //////////////////////////////////////
  // Owner
  //////////////////////////////////////

  ownerId           String

  owner             User
      @relation("OwnedProperties",
      fields:[ownerId],
      references:[id])

  //////////////////////////////////////
  // Agent
  //////////////////////////////////////

  agentId           String?

  agent             User?
      @relation("ManagedProperties",
      fields:[agentId],
      references:[id])

  //////////////////////////////////////
  // Building
  //////////////////////////////////////

  buildingId        String?

  building          Building?
      @relation(fields:[buildingId], references:[id])

  //////////////////////////////////////
  // Unit
  //////////////////////////////////////

  unitId            String?

  unit              Unit?
      @relation(fields:[unitId], references:[id])

  //////////////////////////////////////
  // Smart Trust
  //////////////////////////////////////

  trustScore        Decimal?
      @db.Decimal(5,2)

  verified          Boolean @default(false)

  featured          Boolean @default(false)

  published         Boolean @default(false)

  //////////////////////////////////////
  // Views
  //////////////////////////////////////

  totalViews        Int @default(0)

  totalFavorites    Int @default(0)

  totalBookings     Int @default(0)

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  address           PropertyAddress?

  amenities         PropertyAmenity[]

  features          PropertyFeature[]

  media             PropertyMedia[]

  documents         PropertyDocument[]

  coordinates       PropertyCoordinate[]

  parcel            LandParcel?

  surveyPlans       SurveyPlan[]

  geoJsonFiles      GeoJsonFile[]

  gisFiles          GISFile[]

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  //////////////////////////////////////
  // Indexes
  //////////////////////////////////////

  @@index([propertyCode])

  @@index([status])

  @@index([listingType])

  @@index([ownerId])

  @@index([agentId])

  @@index([organizationId])

  @@index([propertyTypeId])

}

//////////////////////////////////////////////////////
// PROPERTY ADDRESS
//////////////////////////////////////////////////////

model PropertyAddress {
  id                  String   @id @default(cuid())

  propertyId          String   @unique
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  countryId           String
  country             Country @relation(fields: [countryId], references: [id])

  stateId             String
  state               State @relation(fields: [stateId], references: [id])

  localGovernmentId   String?
  localGovernment     LocalGovernment? @relation(fields: [localGovernmentId], references: [id])

  cityId              String
  city                City @relation(fields: [cityId], references: [id])

  districtId          String?
  district            District? @relation(fields: [districtId], references: [id])

  estateId            String?
  estate              Estate? @relation(fields: [estateId], references: [id])

  buildingId          String?
  building            Building? @relation(fields: [buildingId], references: [id])

  unitId              String?
  unit                Unit? @relation(fields: [unitId], references: [id])

  addressLine1        String
  addressLine2        String?

  landmark            String?
  postalCode          String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PROPERTY AMENITIES
//////////////////////////////////////////////////////

model PropertyAmenity {
  id          String @id @default(cuid())

  propertyId  String
  amenityId   String

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity     Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

//////////////////////////////////////////////////////
// PROPERTY FEATURES
//////////////////////////////////////////////////////

model PropertyFeature {
  id          String @id @default(cuid())

  propertyId  String
  featureId   String

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature     Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([propertyId, featureId])
}

//////////////////////////////////////////////////////
// PROPERTY MEDIA
//////////////////////////////////////////////////////

model PropertyMedia {
  id            String @id @default(cuid())

  propertyId    String
