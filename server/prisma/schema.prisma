//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////
// Fixes applied vs. the original:
// - `notifications Notification[]` was declared TWICE in this model
//   (a hard Prisma error) — now appears once.
// - Removed `devices IoTDevice[]`: IoTDevice has no user-ownership field
//   in this schema (devices belong to Property/Building/Unit); user<->device
//   interaction is already modeled via accessLogs and deviceCommands below.
// - Added every back-relation required by other domain files (payments
//   splits/commissions/payouts/invoices, leases, offers, inspections,
//   reviews, favourites, inquiries, IoT access/commands, maintenance,
//   vendor) so none of those relations are one-sided.

model User {
  id             String @id @default(cuid())

  clerkId        String @unique
  email          String @unique

  firstName      String?
  lastName       String?
  gender         Gender?

  phoneNumber    String?
  avatar         String?

  status         UserStatus @default(ACTIVE)
  isVerified     Boolean @default(false)
  isActive       Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Auth / RBAC
  roles                     UserRole[]

  // Wallet / Payments
  wallet                    Wallet?
  payments                  Payment[]
  paymentSplits             PaymentSplit[]
  commissionsEarned         Commission[]
  payouts                   Payout[]
  invoicesReceived          Invoice[]

  // Property
  ownedProperties           Property[] @relation("OwnedProperties")
  managedProperties         Property[] @relation("ManagedProperties")

  // Booking / Marketplace
  agentBookings             Booking[] @relation("BookingAgent")
  bookings                  Booking[]
  inspectionsAssigned       PropertyInspection[] @relation("InspectionInspector")
  offersMade                PropertyOffer[] @relation("PropertyBuyer")
  propertyInquiries         PropertyInquiry[]
  favouriteProperties       FavouriteProperty[]
  propertyReviews           PropertyReview[]

  // Lease
  landlordLeases            Lease[] @relation("LandlordLeases")
  tenantLeases               Lease[] @relation("TenantLeases")
  leaseRenewalsProcessed    LeaseRenewal[] @relation("LeaseRenewedBy")
  leaseNoticesIssued        LeaseNotice[] @relation("LeaseIssuedBy")

  // IoT
  accessLogs                SmartAccessLog[]
  deviceCommands            DeviceCommand[]

  // Maintenance / Vendor
  maintenanceRequests       MaintenanceRequest[]
  maintenanceRequestsAssigned MaintenanceRequest[] @relation("MaintenanceAssignee")
  serviceHistoryPerformed   ServiceHistory[]
  technicianProfile         Technician?
  vendorProfile             Vendor?
  vendorJobs                VendorJob[]
  vendorRatingsGiven        VendorRating[]

  // Notifications / Messaging
  notifications             Notification[]
  conversationParticipants  ConversationParticipant[]
  messages                  Message[]

  // Audit / AI
  auditLogs                 AuditLog[]
  aiRequests                AIRequest[]

  // Blockchain / Investment
  investments               PropertyInvestment[]
  investorDividends         InvestorDividend[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}
