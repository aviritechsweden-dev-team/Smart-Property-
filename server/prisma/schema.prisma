  @@index([propertyId])
}

//////////////////////////////////////////////////////
// GEOJSON
//////////////////////////////////////////////////////

model GeoJsonFile {
  id            String @id @default(cuid())

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  fileUrl       String
  jsonData      Json?

