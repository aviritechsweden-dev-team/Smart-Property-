  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// PAYMENT SPLITS
//////////////////////////////////////////////////////

model PaymentSplit {
  id            String @id @default(cuid())

  paymentId     String
  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  beneficiaryId String
  beneficiary   User @relation(fields: [beneficiaryId], references: [id])

  percentage    Decimal? @db.Decimal(5,2)
  amount        Decimal @db.Decimal(18,2)

  paid          Boolean @default(false)
  paidAt        DateTime?

  createdAt     DateTime @default(now())

  @@index([paymentId])
  @@index([beneficiaryId])
}

//////////////////////////////////////////////////////
// COMMISSIONS
//////////////////////////////////////////////////////

model Commission {
  id            String @id @default(cuid())

  paymentId     String
  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  recipientId   String
  recipient     User @relation(fields: [recipientId], references: [id])

  percentage    Decimal? @db.Decimal(5,2)
  amount        Decimal @db.Decimal(18,2)

  settled       Boolean @default(false)
  settledAt     DateTime?

  createdAt     DateTime @default(now())

  @@index([paymentId])
  @@index([recipientId])
}

//////////////////////////////////////////////////////
// PAYOUT
//////////////////////////////////////////////////////

model Payout {
  id              String @id @default(cuid())

  reference       String @unique

  beneficiaryId   String
  beneficiary     User @relation(fields: [beneficiaryId], references: [id])

  amount          Decimal @db.Decimal(18,2)
  currency        Currency
  status          PaymentStatus

  bankName        String?
  accountName     String?
  accountNumber   String?
  narration       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([beneficiaryId])
}

//////////////////////////////////////////////////////
// INVOICE
//////////////////////////////////////////////////////

model Invoice {
  id              String @id @default(cuid())

  invoiceNumber   String @unique

  paymentId       String? @unique
  payment         Payment? @relation(fields: [paymentId], references: [id])

  customerId      String
  customer        User @relation(fields: [customerId], references: [id])

  subtotal        Decimal @db.Decimal(18,2)
  tax             Decimal @db.Decimal(18,2)
  discount        Decimal @db.Decimal(18,2)
  total           Decimal @db.Decimal(18,2)

  dueDate         DateTime?
  status          PaymentStatus

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}
//////////////////////////////////////////////////////
// LEDGER ACCOUNT
//////////////////////////////////////////////////////

model LedgerAccount {
  id          String @id @default(cuid())

  code        String @unique
  name        String
  category    LedgerCategory

  entries     LedgerEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LEDGER ENTRY
//////////////////////////////////////////////////////

model LedgerEntry {
  id                  String @id @default(cuid())

  accountId           String
  account             LedgerAccount @relation(fields: [accountId], references: [id])

  walletTransactionId String?
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  debit               Decimal @default(0) @db.Decimal(18,2)
  credit              Decimal @default(0) @db.Decimal(18,2)

  narration           String?

  createdAt           DateTime @default(now())

  @@index([accountId])
  @@index([walletTransactionId])
}
//////////////////////////////////////////////////////
// UTILITY / ESTATE BILLS
//////////////////////////////////////////////////////

model UtilityBill {
  id                String @id @default(cuid())

  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  billType          UtilityBillType
  title             String
  billingPeriod     String

  amount            Decimal @db.Decimal(18,2)
  dueDate           DateTime

  status            UtilityBillStatus @default(PENDING)

  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propertyId])
}
//////////////////////////////////////////////////////
// IOT DEVICE
//////////////////////////////////////////////////////
// The original file defined `model IoTDevice` THREE times: one simple
// early version (paired with generic IoTReading/IoTCommand models) and
// two identical richer versions (building/unit scoping, IP/MAC address,
// battery level, paired with MeterReading/SmartAccessLog/DeviceCommand).
// Since the richer version appeared twice with the same complete IoT
// subsystem around it, that's clearly the intended final design — kept
// it and dropped IoTReading/IoTCommand as superseded by MeterReading
// and DeviceCommand below.

model IoTDevice {
  id                 String @id @default(cuid())

  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  buildingId         String?
  building           Building? @relation(fields: [buildingId], references: [id])

  unitId             String?
  unit               Unit? @relation(fields: [unitId], references: [id])

  name               String
  serialNumber       String @unique
  manufacturer       String?
  modelNumber        String?
  firmwareVersion    String?

  type               IoTDeviceType
  status             IoTDeviceStatus @default(ONLINE)

  ipAddress          String?
  macAddress         String?
  lastSeen           DateTime?
  batteryLevel       Int?

  metadata           Json?

  accessLogs         SmartAccessLog[]
  meterReadings      MeterReading[]
  commands           DeviceCommand[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([propertyId])
  @@index([buildingId])
  @@index([unitId])
}

//////////////////////////////////////////////////////
// SMART ACCESS LOG
//////////////////////////////////////////////////////

model SmartAccessLog {
  id                String @id @default(cuid())

  deviceId          String
  device            IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  userId            String?
  user              User? @relation(fields: [userId], references: [id])

  event             AccessEventType
  successful        Boolean
  accessMethod      String?
  ipAddress         String?

  createdAt         DateTime @default(now())

  @@index([deviceId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// METER READING
//////////////////////////////////////////////////////

model MeterReading {
  id               String @id @default(cuid())

  deviceId         String
  device           IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  type             MeterType
  reading          Decimal @db.Decimal(18,3)
  unit             String

  capturedAt       DateTime
  synced           Boolean @default(false)

  createdAt        DateTime @default(now())

  @@index([deviceId])
}

//////////////////////////////////////////////////////
// DEVICE COMMAND
//////////////////////////////////////////////////////

model DeviceCommand {
  id                String @id @default(cuid())

  deviceId          String
  device            IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  userId            String
  user              User @relation(fields: [userId], references: [id])

  command           String
  payload           Json?

  status            DeviceCommandStatus @default(PENDING)
  response          Json?
  executedAt        DateTime?

  createdAt         DateTime @default(now())

  @@index([deviceId])
  @@index([userId])
}
//////////////////////////////////////////////////////
// MAINTENANCE
//////////////////////////////////////////////////////
// New file. The original schema had `User.maintenanceRequests
// MaintenanceRequest[]` and enums like VendorType/VendorStatus, but no
// MaintenanceRequest model (or any model in this domain) was ever
// defined anywhere in the 3,480-line file — a straightforward missing
// type. Built out the full domain the master prompt asked for:
// Maintenance Request, Work Orders, Parts, Service History, Technician.

model MaintenanceRequest {
  id              String @id @default(cuid())

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  requesterId     String
  requester       User @relation(fields: [requesterId], references: [id])

  assignedToId    String?
  assignedTo      User? @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])

  title           String
  description     String?
  category        String?

  priority        MaintenancePriority @default(MEDIUM)
  status          MaintenanceStatus @default(OPEN)

  scheduledAt     DateTime?
  completedAt     DateTime?

  workOrders      WorkOrder[]
  serviceHistory  ServiceHistory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([requesterId])
  @@index([status])
}

//////////////////////////////////////////////////////
// TECHNICIAN
//////////////////////////////////////////////////////

model Technician {
  id            String @id @default(cuid())

  userId        String @unique
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialty     String?
  isActive      Boolean @default(true)

  workOrders    WorkOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

//////////////////////////////////////////////////////
// WORK ORDER
//////////////////////////////////////////////////////

model WorkOrder {
  id                    String @id @default(cuid())

  maintenanceRequestId  String
  maintenanceRequest    MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  technicianId          String?
  technician            Technician? @relation(fields: [technicianId], references: [id])

  vendorId              String?
  vendor                Vendor? @relation(fields: [vendorId], references: [id])

  status                MaintenanceStatus @default(ASSIGNED)
  description           String?

  laborCost             Decimal? @db.Decimal(18,2)
  partsCost             Decimal? @db.Decimal(18,2)
  totalCost             Decimal? @db.Decimal(18,2)

  startedAt             DateTime?
  completedAt           DateTime?

  partsUsed             PartUsage[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([maintenanceRequestId])
  @@index([technicianId])
  @@index([vendorId])
}

//////////////////////////////////////////////////////
// PARTS
//////////////////////////////////////////////////////

model Part {
  id                String @id @default(cuid())

  name              String
  sku               String? @unique

  unitCost          Decimal? @db.Decimal(18,2)
  quantityInStock   Int @default(0)

  usages            PartUsage[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PartUsage {
  id            String @id @default(cuid())

  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  partId        String
  part          Part @relation(fields: [partId], references: [id])

  quantity      Int
  unitCost      Decimal @db.Decimal(18,2)
  totalCost     Decimal @db.Decimal(18,2)

  createdAt     DateTime @default(now())

  @@index([workOrderId])
  @@index([partId])
}

//////////////////////////////////////////////////////
// SERVICE HISTORY
//////////////////////////////////////////////////////

model ServiceHistory {
  id                    String @id @default(cuid())

  maintenanceRequestId  String
  maintenanceRequest    MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  propertyId            String
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  summary               String
  performedAt           DateTime

  performedById         String?
  performedBy           User? @relation(fields: [performedById], references: [id])

  createdAt             DateTime @default(now())

  @@index([maintenanceRequestId])
  @@index([propertyId])
}
//////////////////////////////////////////////////////
// VENDOR
//////////////////////////////////////////////////////
// New file — same gap as maintenance.prisma: VendorType and VendorStatus
// enums existed in the original file (and User referenced VendorJob[])
// but no Vendor, VendorJob, VendorInvoice, VendorPayment, or
// VendorRating models were ever defined.

model Vendor {
  id            String @id @default(cuid())

  userId        String? @unique
  user          User? @relation(fields: [userId], references: [id])

  businessName  String
  type          VendorType
  status        VendorStatus @default(PENDING)

  email         String?
  phone         String?
  address       String?

  averageRating Decimal? @db.Decimal(3,2)

  jobs          VendorJob[]
  invoices      VendorInvoice[]
  payments      VendorPayment[]
  ratings       VendorRating[]
  workOrders    WorkOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
}

//////////////////////////////////////////////////////
// VENDOR JOB
//////////////////////////////////////////////////////

model VendorJob {
  id                    String @id @default(cuid())

  vendorId              String
  vendor                Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  propertyId            String
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  requestedById         String
  requestedBy           User @relation(fields: [requestedById], references: [id])

  maintenanceRequestId  String?

  title                 String
  description           String?

  status                VendorJobStatus @default(ASSIGNED)

  scheduledAt           DateTime?
  completedAt           DateTime?

  amount                Decimal? @db.Decimal(18,2)

  invoice               VendorInvoice?
  rating                VendorRating?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([vendorId])
  @@index([propertyId])
  @@index([requestedById])
}

//////////////////////////////////////////////////////
// VENDOR INVOICE
//////////////////////////////////////////////////////

model VendorInvoice {
  id              String @id @default(cuid())

  vendorId        String
  vendor          Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  vendorJobId     String? @unique
  vendorJob       VendorJob? @relation(fields: [vendorJobId], references: [id])

  invoiceNumber   String @unique
  amount          Decimal @db.Decimal(18,2)
  dueDate         DateTime?
  status          InvoiceStatus @default(PENDING)

  payments        VendorPayment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vendorId])
}

//////////////////////////////////////////////////////
// VENDOR PAYMENT
//////////////////////////////////////////////////////

model VendorPayment {
  id                String @id @default(cuid())

  vendorId          String
  vendor            Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  vendorInvoiceId   String?
  vendorInvoice     VendorInvoice? @relation(fields: [vendorInvoiceId], references: [id])

  paymentId         String? @unique
  payment           Payment? @relation(fields: [paymentId], references: [id])

  amount            Decimal @db.Decimal(18,2)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?

  createdAt         DateTime @default(now())

  @@index([vendorId])
  @@index([vendorInvoiceId])
}

//////////////////////////////////////////////////////
// VENDOR RATING
//////////////////////////////////////////////////////

model VendorRating {
  id            String @id @default(cuid())

  vendorId      String
  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  vendorJobId   String @unique
  vendorJob     VendorJob @relation(fields: [vendorJobId], references: [id], onDelete: Cascade)

  ratedById     String
  ratedBy       User @relation(fields: [ratedById], references: [id])

  rating        Int
  review        String?

  createdAt     DateTime @default(now())

  @@index([vendorId])
}
//////////////////////////////////////////////////////
// BLOCKCHAIN NETWORK
//////////////////////////////////////////////////////
// Note: the original file also had `enum BlockchainNetwork` — a model
// and an enum can't share a top-level name in Prisma. That enum was
// never used anywhere as a field type, so it was renamed to
// BlockchainNetworkType in enums.prisma and this model keeps the name.

model BlockchainNetwork {
  id              String @id @default(cuid())

  name            String
  chainId         String @unique
  symbol          String

  rpcUrl          String?
  explorerUrl     String?

  active          Boolean @default(true)

  tokenizations   PropertyTokenization[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PROPERTY TOKENIZATION
//////////////////////////////////////////////////////

model PropertyTokenization {
  id                    String @id @default(cuid())

  propertyId            String @unique
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  blockchainNetworkId   String
  blockchainNetwork     BlockchainNetwork @relation(fields: [blockchainNetworkId], references: [id])

  status                TokenizationStatus

  tokenSymbol           String
  tokenName             String

  totalSupply           Decimal @db.Decimal(30,8)
  tokenPrice            Decimal @db.Decimal(18,2)
  contractAddress       String?

  assetValue            Decimal @db.Decimal(18,2)
  availableTokens       Decimal @db.Decimal(30,8)

  smartContract         SmartContract?
  investments           PropertyInvestment[]
  tokenTransfers        TokenTransfer[]
  dividendDistributions DividendDistribution[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// SMART CONTRACTS
//////////////////////////////////////////////////////

model SmartContract {
  id                   String @id @default(cuid())

  tokenizationId       String @unique
  tokenization         PropertyTokenization @relation(fields: [tokenizationId], references: [id], onDelete: Cascade)

  contractAddress      String @unique
  abi                  Json?
  bytecodeHash         String?
  deploymentTxHash     String?

  status               SmartContractStatus
  deployedAt           DateTime?

  createdAt            DateTime @default(now())
}

//////////////////////////////////////////////////////
// INVESTMENTS
//////////////////////////////////////////////////////

model PropertyInvestment {
  id                   String @id @default(cuid())

  tokenizationId       String
  tokenization         PropertyTokenization @relation(fields: [tokenizationId], references: [id], onDelete: Cascade)

  investorId           String
  investor             User @relation(fields: [investorId], references: [id])

  paymentId            String?
  payment              Payment? @relation(fields: [paymentId], references: [id])

  tokensPurchased      Decimal @db.Decimal(30,8)
  purchasePrice        Decimal @db.Decimal(18,2)
  investmentValue      Decimal @db.Decimal(18,2)

  walletAddress        String?
  transactionHash      String?

  status               InvestmentStatus

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([investorId])
  @@index([tokenizationId])
}

//////////////////////////////////////////////////////
// TOKEN TRANSFERS
//////////////////////////////////////////////////////

model TokenTransfer {
  id                  String @id @default(cuid())

  tokenizationId      String
  tokenization        PropertyTokenization @relation(fields: [tokenizationId], references: [id])

  fromWallet          String
  toWallet            String
  quantity            Decimal @db.Decimal(30,8)

  transactionHash     String @unique
  blockNumber         String?
  transferredAt       DateTime

  createdAt           DateTime @default(now())

  @@index([tokenizationId])
}

//////////////////////////////////////////////////////
// DIVIDENDS
//////////////////////////////////////////////////////

model DividendDistribution {
  id                  String @id @default(cuid())

  tokenizationId      String
  tokenization        PropertyTokenization @relation(fields: [tokenizationId], references: [id])

  totalAmount         Decimal @db.Decimal(18,2)
  currency            Currency
  distributionDate    DateTime
  notes               String?

  investorDividends   InvestorDividend[]

  createdAt           DateTime @default(now())

  @@index([tokenizationId])
}

//////////////////////////////////////////////////////
// INVESTOR DIVIDENDS
//////////////////////////////////////////////////////

model InvestorDividend {
  id                    String @id @default(cuid())

  dividendId            String
  dividend              DividendDistribution @relation(fields: [dividendId], references: [id], onDelete: Cascade)

  investorId            String
  investor              User @relation(fields: [investorId], references: [id])

  paymentId             String?
  payment               Payment? @relation(fields: [paymentId], references: [id])

  amount                Decimal @db.Decimal(18,2)
  paid                  Boolean @default(false)
  paidAt                DateTime?

  createdAt             DateTime @default(now())

  @@unique([dividendId, investorId])
}
//////////////////////////////////////////////////////
// AUDIT LOGS
//////////////////////////////////////////////////////

model AuditLog {
  id              String @id @default(cuid())

  userId          String?
  user            User? @relation(fields: [userId], references: [id])

  action          AuditAction
  entity          String
  entityId        String

  description     String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?

  createdAt       DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([userId])
}
//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model Notification {
  id               String @id @default(cuid())

  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type             NotificationType
  channel          NotificationChannel

  title            String
  body             String

  status           NotificationStatus @default(PENDING)

  data             Json?

  readAt           DateTime?
  sentAt           DateTime?

  createdAt        DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////
// CONVERSATIONS
//////////////////////////////////////////////////////

model Conversation {
  id              String @id @default(cuid())

  type            ConversationType
  title           String?

  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])

  participants    ConversationParticipant[]
  messages        Message[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// PARTICIPANTS
//////////////////////////////////////////////////////

model ConversationParticipant {
  id              String @id @default(cuid())

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId          String
  user            User @relation(fields: [userId], references: [id])

  joinedAt        DateTime @default(now())

  @@unique([conversationId, userId])
}

//////////////////////////////////////////////////////
// MESSAGES
//////////////////////////////////////////////////////

model Message {
  id               String @id @default(cuid())

  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId         String
  sender           User @relation(fields: [senderId], references: [id])

  type             MessageType
  message          String?
  attachmentUrl    String?

  isRead           Boolean @default(false)

  createdAt        DateTime @default(now())

  @@index([conversationId])
}
//////////////////////////////////////////////////////
// AI REQUESTS
//////////////////////////////////////////////////////

model AIRequest {
  id              String @id @default(cuid())

  userId          String
  user            User @relation(fields: [userId], references: [id])

  provider        AIProvider
  prompt          String
  response        String?
  tokens          Int?
  cost            Decimal? @db.Decimal(18,6)

  createdAt       DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////
// SYSTEM SETTINGS
//////////////////////////////////////////////////////

model SystemSetting {
  id             String @id @default(cuid())

  key            String @unique
  value          Json
  description    String?
  updatedBy      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

//////////////////////////////////////////////////////
// INTEGRATIONS / API KEYS
//////////////////////////////////////////////////////

model Integration {
  id             String @id @default(cuid())

  name           String @unique
  provider       String

  apiKey         String?
  secretKey      String?
  webhookSecret  String?
  configuration  Json?

  enabled        Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
