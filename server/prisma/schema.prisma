  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// UNIT
//////////////////////////////////////////////////////

model Unit {
  id          String @id @default(cuid())

  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])

  unitNumber  String

  floor       Int?

  properties  Property[]

  addresses   PropertyAddress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([buildingId, unitNumber])
