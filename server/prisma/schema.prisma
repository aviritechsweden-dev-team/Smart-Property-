  amount        Decimal @db.Decimal(18,2)
  reason        String?
  status        PaymentStatus

  processedAt   DateTime?

  createdAt     DateTime @default(now())

  @@index([paymentId])
}

//////////////////////////////////////////////////////
// ESCROW
//////////////////////////////////////////////////////

model Escrow {
  id            String @id @default(cuid())

