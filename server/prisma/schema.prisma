// GEOJSON
//////////////////////////////////////////////////////

model GeoJsonFile {
  id            String @id @default(cuid())

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  fileUrl       String

  jsonData      Json?

  createdAt     DateTime @default(now())

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// GIS FILES
//////////////////////////////////////////////////////

model GISFile {
  id            String @id @default(cuid())

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type          GISFileType

  fileUrl       String

  createdAt     DateTime @default(now())

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// WALLET
//////////////////////////////////////////////////////

model Wallet {
  id              String   @id @default(cuid())

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletNumber    String   @unique

  currency        Currency @default(NGN)

  availableBalance Decimal @default(0) @db.Decimal(18,2)

  holdBalance      Decimal @default(0) @db.Decimal(18,2)

  totalBalance     Decimal @default(0) @db.Decimal(18,2)

  status          WalletStatus @default(ACTIVE)

  transactions    WalletTransaction[]

  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([walletNumber])
}

//////////////////////////////////////////////////////
// WALLET TRANSACTIONS
//////////////////////////////////////////////////////

model WalletTransaction {

  id                String @id @default(cuid())

  walletId          String
  wallet            Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  reference         String @unique

  type              WalletTransactionType

  amount            Decimal @db.Decimal(18,2)

  balanceBefore     Decimal @db.Decimal(18,2)

  balanceAfter      Decimal @db.Decimal(18,2)

  description       String?

  paymentId         String?

  ledgerEntries     LedgerEntry[]

  createdAt         DateTime @default(now())

  @@index([walletId])

  @@index([reference])
}

//////////////////////////////////////////////////////
// LEDGER ACCOUNT
//////////////////////////////////////////////////////

model LedgerAccount {

  id              String @id @default(cuid())

  code            String @unique

  name            String

  category        LedgerCategory

  entries         LedgerEntry[]

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LEDGER ENTRY
//////////////////////////////////////////////////////

model LedgerEntry {

  id                 String @id @default(cuid())

  accountId          String

  account            LedgerAccount
      @relation(fields:[accountId], references:[id])

  walletTransactionId String?

  walletTransaction  WalletTransaction?
      @relation(fields:[walletTransactionId], references:[id])

  debit              Decimal @default(0)
      @db.Decimal(18,2)

  credit             Decimal @default(0)
      @db.Decimal(18,2)

  narration          String?

  createdAt          DateTime @default(now())

  @@index([accountId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {

  id                String @id @default(cuid())

  reference         String @unique

  payerId           String

  payer             User
      @relation(fields:[payerId], references:[id])

  walletId          String?

  wallet            Wallet?
      @relation(fields:[walletId], references:[id])

  purpose           PaymentPurpose

  method            PaymentMethod

  status            PaymentStatus
      @default(PENDING)

  currency          Currency
      @default(NGN)

  amount            Decimal
      @db.Decimal(18,2)

  fee               Decimal?
      @db.Decimal(18,2)

  discount          Decimal?
      @db.Decimal(18,2)

  tax               Decimal?
      @db.Decimal(18,2)

  total             Decimal
      @db.Decimal(18,2)

  description       String?

  investments       PropertyInvestment[]

  investorDividends InvestorDividend[]

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  flutterwave       FlutterwaveTransaction?

  @@index([reference])

  @@index([payerId])

  @@index([status])

}

//////////////////////////////////////////////////////
// FLUTTERWAVE TRANSACTION
//////////////////////////////////////////////////////

model FlutterwaveTransaction {

  id                String @id @default(cuid())

  paymentId         String @unique
  payment           Payment
      @relation(fields:[paymentId], references:[id], onDelete: Cascade)

  txRef             String @unique

  flwRef            String?

  transactionId     String?

  amount            Decimal @db.Decimal(18,2)

  chargedAmount     Decimal? @db.Decimal(18,2)

  currency          Currency

  customerEmail     String?

  customerPhone     String?

  paymentType       String?

  processorResponse String?

  gatewayStatus     String?

  webhookPayload    Json?

  verified          Boolean @default(false)

  verifiedAt        DateTime?

  createdAt         DateTime @default(now())

  @@index([txRef])
}

//////////////////////////////////////////////////////
// WEBHOOK EVENTS
//////////////////////////////////////////////////////

model WebhookEvent {

  id            String @id @default(cuid())

  provider      String

  eventType     String

  reference     String?

  payload       Json

  processed     Boolean @default(false)

  processedAt   DateTime?

  createdAt     DateTime @default(now())

  @@index([provider])

  @@index([eventType])
}

//////////////////////////////////////////////////////
// REFUNDS
//////////////////////////////////////////////////////

model Refund {

  id            String @id @default(cuid())

  paymentId     String

  payment       Payment
      @relation(fields:[paymentId], references:[id], onDelete: Cascade)

  amount        Decimal
      @db.Decimal(18,2)

  reason        String?

  status        PaymentStatus

  processedAt   DateTime?

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// ESCROW
