  fileUrl       String

  createdAt     DateTime @default(now())

  @@index([propertyId])
}
//////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////
// The original file defined `model Booking` TWICE with incompatible
// designs: one keyed off Property directly (with agent, inspections,
// offers, check-in/out), and one keyed off a separate PropertyListing
// model (marketplace-style, with checkIn/checkOut, totalAmount).
// Merged into a single model: kept the richer Property-based design and
// added an optional listingId so a booking can also originate from a
// PropertyListing (marketplace flow). Nothing from either version was
// dropped — `PropertyListing.bookings` still resolves correctly.

model Booking {
  id              String @id @default(cuid())

  reference       String @unique

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  listingId       String?
  listing         PropertyListing? @relation(fields: [listingId], references: [id])

  customerId      String
  customer        User @relation(fields: [customerId], references: [id])

  agentId         String?
  agent           User? @relation("BookingAgent", fields: [agentId], references: [id])

  bookingType     BookingType
  status          BookingStatus @default(PENDING)

  startDate       DateTime
  endDate         DateTime?

  guests          Int @default(1)

  amount          Decimal? @db.Decimal(18,2)
  bookingFee      Decimal? @db.Decimal(18,2)

  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])

  notes           String?

  checkedInAt     DateTime?
  checkedOutAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspections     PropertyInspection[]
  offers          PropertyOffer[]
  leases          Lease[]

  @@index([propertyId])
  @@index([listingId])
  @@index([customerId])
  @@index([status])
}

//////////////////////////////////////////////////////
// PROPERTY INSPECTIONS
//////////////////////////////////////////////////////

model PropertyInspection {
  id              String @id @default(cuid())

  bookingId       String
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  inspectorId     String?
  inspector       User? @relation("InspectionInspector", fields: [inspectorId], references: [id])

  scheduledAt     DateTime
  status          InspectionStatus @default(PENDING)
  remarks         String?
  completedAt     DateTime?

  createdAt       DateTime @default(now())

  @@index([bookingId])
  @@index([propertyId])
}

//////////////////////////////////////////////////////
// PROPERTY OFFERS
//////////////////////////////////////////////////////
// Same merge as Booking above: two conflicting PropertyOffer models
// (Property-based with `booking` link, and PropertyListing-based with
// a `message` field) combined into one, with `message` folded into the
// existing `notes` field.

model PropertyOffer {
  id              String @id @default(cuid())

  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  listingId       String?
  listing         PropertyListing? @relation(fields: [listingId], references: [id])

  buyerId         String
  buyer           User @relation("PropertyBuyer", fields: [buyerId], references: [id])

  offerAmount     Decimal @db.Decimal(18,2)
  status          OfferStatus @default(PENDING)
  expiresAt       DateTime?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([listingId])
  @@index([buyerId])
}

//////////////////////////////////////////////////////
// PROPERTY LISTING (marketplace layer over Property)
//////////////////////////////////////////////////////

model PropertyListing {
  id              String @id @default(cuid())

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  listingType     ListingType
  status          ListingStatus @default(DRAFT)

  title           String
  description     String?

  askingPrice     Decimal @db.Decimal(18,2)
  securityDeposit Decimal? @db.Decimal(18,2)
  serviceCharge   Decimal? @db.Decimal(18,2)

  minimumStay     Int?
  availableFrom   DateTime?
  availableTo     DateTime?

  publishedAt     DateTime?
  expiresAt       DateTime?

  views           Int @default(0)

  bookings        Booking[]
  offers          PropertyOffer[]
  inquiries       PropertyInquiry[]
  favourites      FavouriteProperty[]
  reviews         PropertyReview[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

//////////////////////////////////////////////////////
// PROPERTY INQUIRIES
//////////////////////////////////////////////////////

model PropertyInquiry {
  id             String @id @default(cuid())

  listingId      String
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  userId         String
  user           User @relation(fields: [userId], references: [id])

  subject        String
  message        String
  responded      Boolean @default(false)

  createdAt      DateTime @default(now())
}

//////////////////////////////////////////////////////
// FAVOURITE PROPERTIES
//////////////////////////////////////////////////////

model FavouriteProperty {
  id             String @id @default(cuid())

  listingId      String
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  userId         String
  user           User @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())

  @@unique([listingId, userId])
}

//////////////////////////////////////////////////////
// PROPERTY REVIEWS
//////////////////////////////////////////////////////

model PropertyReview {
  id             String @id @default(cuid())

  listingId      String
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reviewerId     String
  reviewer       User @relation(fields: [reviewerId], references: [id])

  rating         Int
  title          String?
  review         String?

  createdAt      DateTime @default(now())

  @@index([listingId])
}
//////////////////////////////////////////////////////
// LEASE
//////////////////////////////////////////////////////

model Lease {
  id                 String @id @default(cuid())

  leaseNumber        String @unique

  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  landlordId         String
  landlord           User @relation("LandlordLeases", fields: [landlordId], references: [id])

  tenantId           String
  tenant             User @relation("TenantLeases", fields: [tenantId], references: [id])

  bookingId          String?
  booking            Booking? @relation(fields: [bookingId], references: [id])

  status             LeaseStatus @default(DRAFT)

  startDate          DateTime
  endDate            DateTime

  rentFrequency      RentFrequency
  rentAmount         Decimal @db.Decimal(18,2)
  securityDeposit    Decimal? @db.Decimal(18,2)
  serviceCharge      Decimal? @db.Decimal(18,2)
  cautionFee         Decimal? @db.Decimal(18,2)

  agreementUrl       String?
  notes              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoices           RentInvoice[]
  renewals           LeaseRenewal[]
  notices            LeaseNotice[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([bookingId])
}

//////////////////////////////////////////////////////
// RENT INVOICES
//////////////////////////////////////////////////////

model RentInvoice {
  id                String @id @default(cuid())

  leaseId           String
  lease             Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  invoiceNumber     String @unique
  dueDate           DateTime

  amount            Decimal @db.Decimal(18,2)
  paidAmount        Decimal @default(0) @db.Decimal(18,2)
  balance           Decimal @db.Decimal(18,2)

  status            InvoiceStatus @default(PENDING)

  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([leaseId])
