//////////////////////////////////////////////////////
// IOT
//////////////////////////////////////////////////////

enum IoTDeviceType {
  SMART_LOCK
  SMART_METER
  WATER_METER
  GAS_METER
  CCTV
  CAMERA
  DOOR_SENSOR
  MOTION_SENSOR
  SMOKE_SENSOR
  FIRE_SENSOR
  FLOOD_SENSOR
  TEMPERATURE_SENSOR
  HUMIDITY_SENSOR
  LIGHT
  SWITCH
  GATE_CONTROLLER
  SOLAR_INVERTER
  GENERATOR
  EV_CHARGER
  OTHER
}

enum IoTDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
  FAULTY
}

model IoTDevice {
  id              String @id @default(cuid())

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitId          String?
  unit            Unit? @relation(fields: [unitId], references: [id])

  serialNumber    String @unique
  manufacturer    String?
  model           String?

  deviceType      IoTDeviceType
  status          IoTDeviceStatus @default(OFFLINE)

  firmwareVersion String?

  lastSeen        DateTime?

  installedAt     DateTime?
  activatedAt     DateTime?

  metadata        Json?

  readings        IoTReading[]
  commands        IoTCommand[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([serialNumber])
}

model IoTReading {
  id            String @id @default(cuid())

  deviceId      String
  device        IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  metric        String
  value         Decimal @db.Decimal(18,4)

  unit          String?

  recordedAt    DateTime @default(now())

  rawPayload    Json?

  @@index([deviceId])
  @@index([recordedAt])
}

model IoTCommand {
  id            String @id @default(cuid())

  deviceId      String
  device        IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  command       String

  payload       Json?

  executed      Boolean @default(false)

  executedAt    DateTime?

  response      Json?

  createdAt     DateTime @default(now())

  @@index([deviceId])
}

//////////////////////////////////////////////////////
// BOOKINGS & VIEWINGS
//////////////////////////////////////////////////////

enum BookingType {
  PROPERTY_VIEWING
  SHORTLET
  RENTAL
  PROPERTY_PURCHASE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

model Booking {
  id              String @id @default(cuid())

  reference       String @unique

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  customerId      String
  customer        User @relation(fields: [customerId], references: [id])

  agentId         String?
  agent           User? @relation("BookingAgent", fields: [agentId], references: [id])

  bookingType     BookingType
  status          BookingStatus @default(PENDING)

  startDate       DateTime
  endDate         DateTime?

  guests          Int?

  amount          Decimal? @db.Decimal(18,2)
  bookingFee      Decimal? @db.Decimal(18,2)

  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])

  notes           String?

  checkedInAt     DateTime?
  checkedOutAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspections     PropertyInspection[]
  offers          PropertyOffer[]

  @@index([propertyId])
  @@index([customerId])
  @@index([status])
}

//////////////////////////////////////////////////////
// PROPERTY INSPECTIONS
//////////////////////////////////////////////////////

enum InspectionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  MISSED
}

model PropertyInspection {
  id              String @id @default(cuid())

  bookingId       String
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  inspectorId     String?
  inspector       User? @relation("InspectionInspector", fields: [inspectorId], references: [id])

  scheduledAt     DateTime

  status          InspectionStatus @default(PENDING)

  remarks         String?

  completedAt     DateTime?

  createdAt       DateTime @default(now())
}

//////////////////////////////////////////////////////
// PROPERTY OFFERS
//////////////////////////////////////////////////////

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model PropertyOffer {
  id              String @id @default(cuid())

  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])

  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  buyerId         String
  buyer           User @relation("PropertyBuyer", fields: [buyerId], references: [id])

  offerAmount     Decimal @db.Decimal(18,2)

  status          OfferStatus @default(PENDING)

  expiresAt       DateTime?

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([buyerId])
}

//////////////////////////////////////////////////////
// LEASES & TENANCY
//////////////////////////////////////////////////////

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
  CANCELLED
}

enum RentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

model Lease {
  id                 String @id @default(cuid())

  leaseNumber        String @unique

  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  landlordId         String
  landlord           User @relation("LandlordLeases", fields: [landlordId], references: [id])

  tenantId           String
  tenant             User @relation("TenantLeases", fields: [tenantId], references: [id])

  bookingId          String?
  booking            Booking? @relation(fields: [bookingId], references: [id])

  status             LeaseStatus @default(DRAFT)

  startDate          DateTime
  endDate            DateTime

  rentFrequency      RentFrequency

  rentAmount         Decimal @db.Decimal(18,2)

  securityDeposit    Decimal? @db.Decimal(18,2)

  serviceCharge      Decimal? @db.Decimal(18,2)

  cautionFee         Decimal? @db.Decimal(18,2)

  agreementUrl       String?

  notes              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoices           RentInvoice[]
  renewals           LeaseRenewal[]
  notices            LeaseNotice[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
}

//////////////////////////////////////////////////////
// RENT INVOICES
//////////////////////////////////////////////////////

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model RentInvoice {
  id                String @id @default(cuid())

  leaseId           String
  lease             Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  invoiceNumber     String @unique

  dueDate           DateTime

  amount            Decimal @db.Decimal(18,2)

  paidAmount        Decimal @default(0) @db.Decimal(18,2)

  balance           Decimal @db.Decimal(18,2)

  status            InvoiceStatus @default(PENDING)

  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LEASE RENEWALS
//////////////////////////////////////////////////////

model LeaseRenewal {
  id                String @id @default(cuid())

  leaseId           String
  lease             Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  previousEndDate   DateTime

  newEndDate        DateTime

  newRent           Decimal? @db.Decimal(18,2)

  renewedById       String?
  renewedBy         User? @relation("LeaseRenewedBy", fields: [renewedById], references: [id])

  createdAt         DateTime @default(now())
}

//////////////////////////////////////////////////////
// LEASE NOTICES
//////////////////////////////////////////////////////

enum NoticeType {
  WARNING
  RENT_DUE
  RENT_OVERDUE
  TERMINATION
  VACATE
  GENERAL
}

model LeaseNotice {
  id                String @id @default(cuid())

  leaseId           String
  lease             Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  type              NoticeType

  title             String

  message           String

  issuedById        String
  issuedBy          User @relation("LeaseIssuedBy", fields: [issuedById], references: [id])

  acknowledged      Boolean @default(false)

  createdAt         DateTime @default(now())
}
