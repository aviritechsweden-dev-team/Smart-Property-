  @@index([propertyId])
}

//////////////////////////////////////////////////////
// GIS FILES
//////////////////////////////////////////////////////

model GISFile {
  id            String @id @default(cuid())

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

