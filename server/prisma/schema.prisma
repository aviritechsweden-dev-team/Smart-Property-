  latitude      Decimal @db.Decimal(10,8)
  longitude     Decimal @db.Decimal(11,8)
  altitude      Decimal? @db.Decimal(8,2)

  pointOrder    Int

  createdAt     DateTime @default(now())

  @@index([propertyId])
}

//////////////////////////////////////////////////////
// LAND PARCEL
//////////////////////////////////////////////////////

model LandParcel {
