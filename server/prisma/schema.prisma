model Escrow {

  id            String @id @default(cuid())

  paymentId     String @unique

  payment       Payment
      @relation(fields:[paymentId], references:[id], onDelete: Cascade)

  amount        Decimal
      @db.Decimal(18,2)

  released      Boolean @default(false)

  releasedAt    DateTime?

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// PAYMENT SPLITS
