  leaseId           String
  lease             Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  previousEndDate   DateTime
  newEndDate        DateTime
  newRent           Decimal? @db.Decimal(18,2)

  renewedById       String?
  renewedBy         User? @relation("LeaseRenewedBy", fields: [renewedById], references: [id])

  createdAt         DateTime @default(now())
}

//////////////////////////////////////////////////////
// LEASE NOTICES
//////////////////////////////////////////////////////

model LeaseNotice {
  id                String @id @default(cuid())

  leaseId           String
  lease             Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  type              NoticeType
  title             String
  message           String

  issuedById        String
  issuedBy          User @relation("LeaseIssuedBy", fields: [issuedById], references: [id])

  acknowledged      Boolean @default(false)

  createdAt         DateTime @default(now())
