  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  parcelNumber    String?
  area            Decimal? @db.Decimal(18,2)
  perimeter       Decimal? @db.Decimal(18,2)
  measurementUnit String? @default("sqm")

