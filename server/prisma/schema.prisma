//////////////////////////////////////////////////////

model WebhookEvent {
  id            String @id @default(cuid())

  provider      String
  eventType     String
  reference     String?

  payload       Json

  processed     Boolean @default(false)
  processedAt   DateTime?

  createdAt     DateTime @default(now())

  @@index([provider])
  @@index([eventType])
}

//////////////////////////////////////////////////////
// REFUNDS
//////////////////////////////////////////////////////

model Refund {
